{# Auth layout — Chillimedia brand, original authentication flow #}
<!DOCTYPE html>
<html lang="en" data-theme="light" x-data="{ theme: localStorage.getItem('oci-theme') || 'light' }" x-init="$el.setAttribute('data-theme', theme)">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Chilli Consent{% endblock %} — Consent Management Platform</title>

    <link rel="stylesheet" href="/assets/vendor/inter/inter.css">
    <link rel="stylesheet" href="/assets/vendor/bulma-1.0.2/bulma.min.css">
    <link rel="stylesheet" href="/assets/vendor/fontawesome-6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/app.css">

    <script defer src="/assets/vendor/alpinejs-3.17.4/cdn.min.js"></script>

    <link rel="stylesheet" href="/assets/css/chilli-brand.css?v=20261020-1">
    <link rel="icon" type="image/svg+xml" href="/media/chillimedia-mark.svg">

    {% block head %}{% endblock %}
</head>
<body>
    <div class="auth-page">
        <div class="auth-container">
            <div class="auth-logo">
                <img src="/media/chillimedia-logo.svg"
                     :src="theme === 'dark' ? '/media/chillimedia-logo-on-dark.svg' : '/media/chillimedia-logo.svg'"
                     alt="Chillimedia" class="logo-img" width="164" height="45">
                <p class="auth-product-name">Consent</p>
            </div>

            {% block content %}{% endblock %}

            <div class="auth-footer">
                {% block footer %}{% endblock %}
            </div>
        </div>
    </div>

    {% block scripts %}{% endblock %}
</body>
</html>
