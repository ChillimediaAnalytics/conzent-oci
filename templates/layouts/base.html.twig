<!DOCTYPE html>
<html lang="en" data-theme="light"
      x-data="{ sidebarOpen: window.innerWidth >= 1024, theme: localStorage.getItem('oci-theme') || 'light' }"
      x-init="$el.setAttribute('data-theme', theme)"
      @resize.window="if (window.innerWidth >= 1024) sidebarOpen = true">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Chilli Consent{% endblock %} — Consent Management Platform</title>

    {# Inter font #}
    <link rel="stylesheet" href="/assets/vendor/inter/inter.css">

    {# Bulma CSS #}
    <link rel="stylesheet" href="/assets/vendor/bulma-1.0.2/bulma.min.css">

    {# Font Awesome (global — no need to include per page) #}
    <link rel="stylesheet" href="/assets/vendor/fontawesome-6.5.1/css/all.min.css">

    {# OCI custom styles #}
    <link rel="stylesheet" href="/assets/css/app.css?v=10">
    <link rel="stylesheet" href="/assets/css/chilli-brand.css?v=20261020-1">
    <link rel="icon" type="image/svg+xml" href="/media/chillimedia-mark.svg">

    {# Alpine.js + htmx + marked.js (for notification markdown) #}
    <script defer src="/assets/vendor/alpinejs-3.17.4/cdn.min.js"></script>
    <script src="/assets/vendor/htmx-2.0.4/htmx.min.js"></script>
    <script src="/assets/vendor/marked-18.1.1/marked.umd.js"></script>

    {% block head %}{% endblock %}
</head>
<body>

    {# Top navbar (3-column grid) #}
    {% block navbar %}
        {% include 'components/navbar.html.twig' %}
    {% endblock %}

    {# Layout wrapper #}
    <div class="oci-layout">
        {# Mobile overlay #}
        <div class="oci-overlay" x-show="sidebarOpen" x-transition.opacity
             @click="sidebarOpen = false" x-cloak></div>

        {# Sidebar — admin pages get an admin-only menu; everything else the consumer menu.
           The --admin modifier lets the menu's group sub-flyouts escape the sidebar. #}
        <aside class="oci-sidebar{% if active_page is defined and active_page starts with 'admin_' %} oci-sidebar--admin{% endif %}"
               :class="{ 'is-open': sidebarOpen }" x-cloak>
            {% block sidebar %}
                {% if active_page is defined and active_page starts with 'admin_' %}
                    {% include 'components/sidebar_admin.html.twig' %}
                {% else %}
                    {% include 'components/sidebar.html.twig' %}
                {% endif %}
            {% endblock %}
        </aside>

        {# Main content #}
        <main class="oci-main" id="main-content">
            {# Flash messages #}
            {% block flash %}
                {% if flash is defined and flash %}
                    {% for type, message in flash %}
                        <div class="notification is-{{ type }} is-light mb-4">
                            <button class="delete" onclick="this.parentElement.remove()"></button>
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endif %}
            {% endblock %}

            {# Page content #}
            {% block content %}{% endblock %}
        </main>
    </div>

    {# Footer (2-column grid matching sidebar) #}
    {% block footer %}
        {% include 'components/footer.html.twig' %}
    {% endblock %}

    {# Notification bell Alpine component #}
    <script>
    function notificationBell() {
        return {
            open: false,
            notifications: [],
            unreadCount: 0,
            modalOpen: false,
            modalTitle: '',
            modalBody: '',

            async load() {
                try {
                    const res = await fetch('/app/notifications');
                    const json = await res.json();
                    if (json.success) {
                        this.notifications = json.data.notifications;
                        this.unreadCount = json.data.unread_count;
                    }
                } catch (e) {
                    // silently fail — notifications are non-critical
                }
            },

            toggle() {
                this.open = !this.open;
            },

            async openNotification(n) {
                if (!n.is_read) {
                    fetch('/app/notifications/read', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ slug: n.slug }),
                    });
                    n.is_read = true;
                    this.unreadCount = Math.max(0, this.unreadCount - 1);
                }

                try {
                    const res = await fetch('/app/notifications/' + encodeURIComponent(n.slug));
                    const json = await res.json();
                    if (json.success) {
                        this.modalTitle = json.data.title;
                        this.modalBody = marked.parse(json.data.body);
                        this.modalOpen = true;
                        this.open = false;
                    }
                } catch (e) {
                    // fallback: show excerpt
                    this.modalTitle = n.title;
                    this.modalBody = '<p>' + n.excerpt + '</p>';
                    this.modalOpen = true;
                    this.open = false;
                }
            },

            async markAllRead() {
                try {
                    await fetch('/app/notifications/read-all', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                    });
                    this.notifications.forEach(n => n.is_read = true);
                    this.unreadCount = 0;
                } catch (e) {}
            }
        };
    }
    </script>

    {% if chat_service_url is defined and chat_service_url %}
    <!-- Conzent Chat Widget -->
    <script>
    window.ConzentChatConfig = {
      serviceUrl: '{{ chat_service_url|default("/chat") }}',
      {% if current_user is defined and current_user %}
      visitor: {
        name: "{{ current_user.first_name|e('js') }} {{ current_user.last_name|default('')|e('js') }}",
        email: "{{ current_user.email|e('js') }}"
      },
      meta: { source: 'dashboard', user_id: '{{ current_user.id|default('') }}', plan: '{{ current_user.plan|default('free') }}', page: window.location.pathname }
      {% else %}
      meta: { source: 'public' }
      {% endif %}
    };
    </script>
    <script async src="{{ chat_service_url|default('/chat') }}/widget/conzent-chat.js?v={{ chat_widget_version|default('2') }}" onerror=""></script>
    <!-- /Conzent Chat Widget -->
    {% endif %}

    {# Shared modals: ocMessage()/ocConfirm() — alert()/confirm() are banned.
       Included BEFORE the page scripts so the functions exist when they run. #}
    {% include 'partials/_app_modals.html.twig' %}

    {# Page-specific scripts #}
    {% block scripts %}{% endblock %}
</body>
</html>
